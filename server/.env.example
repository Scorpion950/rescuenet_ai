PORT=5000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
# Firebase Admin credentials (choose ONE):
# Local: add server/serviceAccountKey.json (automatically detected, NOT distributed).
# Or supply an absolute path. Quote Windows paths containing spaces in .env.
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# Cloud deployment: set FIREBASE_SERVICE_ACCOUNT to the complete JSON as a
# SERVER-ONLY secret, or use Google Cloud workload identity (ADC).
# FIREBASE_SERVICE_ACCOUNT=
# Local emulator only (requires BOTH variables, never on a deployed server):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.rescuenet.local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLOUDINARY_CLOUD_NAME=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Real push messages are OFF unless explicitly enabled after testing and consent.
ENABLE_PUSH_DELIVERY=false
RUN_BACKGROUND_JOBS=true
