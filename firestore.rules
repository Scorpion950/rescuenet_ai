rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roleIs(role) {
      return signedIn() && request.auth.token.role == role;
    }
    function admin() {
      return roleIs('admin');
    }
    function responder() {
      return roleIs('responder');
    }
    function currentUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    match /reports/{reportId} {
      allow read: if true;
      allow write: if false; // All writes pass through the API
      match /votes/{uid} {
        allow read: if currentUser(uid) || admin();
        allow write: if false;
      }
    }
    match /users/{uid} {
      allow read: if currentUser(uid) || admin();
      allow write: if false;
    }
    match /sosAlerts/{id} {
      allow read: if admin() ||
        (responder() && request.auth.token.department in resource.data.services) ||
        (signedIn() && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }
    match /incident_distributions/{id} {
      allow read: if admin() ||
        (responder() &&
          request.auth.token.department == resource.data.responderType);
      allow write: if false;
    }
    match /notifications/{uid}/items/{id} {
      allow read: if currentUser(uid) || admin();
      allow write: if false;
    }
    match /notification_jobs/{id} {
      allow read, write: if false;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
